.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
/dist/
/out/
coverage/
*.log

# In-repo tool caches (toolchain, models, downloads)
.cache/
