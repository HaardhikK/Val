# Secrets and credentials: never commit
.env
.env.*
.envrc
*.pem
*.key
*.p12
*credentials*.json
*service-account*.json
secrets.json
secrets.yaml
secrets.yml
secrets.toml
*.secrets
.mcp.json
id_rsa*
id_ed25519*

# OS
.DS_Store
Thumbs.db

